{
  "name": "aps-platform",
  "type": "module",
  "version": "1.0.0",
  "description": "APS Publishing Platform — A structured research instrument for the Agency-Process-Scale framework",
  "scripts": {
    "dev": "astro dev",
    "prebuild": "npm run clean:astro && npx tsx src/scripts/check-frontmatter-type.ts && npx tsx src/scripts/content-lint.ts && npx tsx src/scripts/check-links.ts && npx tsx src/scripts/check-canonical-lock.ts",
    "build": "astro build",
    "postbuild": "npx tsx src/scripts/generate-redirects.ts && npx pagefind --site dist",
    "preview": "astro preview",
    "lint": "eslint . --ext .ts,.astro",
    "lint:content": "npx tsx src/scripts/content-lint.ts",
    "check:links": "npx tsx src/scripts/check-links.ts",
    "check:canonical": "npx tsx src/scripts/check-canonical-lock.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean:astro": "node -e \"const fs=require('fs'); for (const dir of ['.astro','node_modules/.astro']) fs.rmSync(dir,{recursive:true,force:true});\"",
    "clean": "node -e \"const fs=require('fs'); for (const dir of ['.astro','node_modules/.astro','dist']) fs.rmSync(dir,{recursive:true,force:true});\"",
    "build:clean": "npm run clean && npm run build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@astrojs/sitemap": "^3.7.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "astro": "^5.18.0",
    "js-yaml": "^5.2.1",
    "pagefind": "^1.4.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/js-yaml": "^4.0.9",
    "eslint": "^10.0.2",
    "eslint-plugin-astro": "^1.6.0",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  }
}
