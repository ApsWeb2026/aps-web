
---
const { pathname } = Astro.url;

const navItems = [
  { label: 'Home', href: '/' },
  { label: 'What Is APS', href: '/orientation/what-is-aps/' },
  { label: 'Articles', href: '/articles/' },
  { label: 'Research', href: '/research/' },
  { label: 'Glossary', href: '/glossary/' },
];

const topicGroups = [
  {
    heading: 'Foundations and Methods',
    items: [
      {
        label: 'Conceptual Foundations',
        href: '/clusters/conceptual-foundations/',
      },
      {
        label: 'Methodology and Explanation',
        href: '/clusters/methodology-and-explanation/',
      },
      {
        label: 'Philosophy of Biology',
        href: '/clusters/philosophy-of-biology/',
      },
      {
        label: 'History of Ideas',
        href: '/clusters/history-of-ideas/',
      },
    ],
  },
  {
    heading: 'Biological Domains',
    items: [
      {
        label: 'Evolutionary Dynamics',
        href: '/clusters/evolutionary-dynamics/',
      },
      {
        label: 'Developmental Organisation',
        href: '/clusters/developmental-organisation/',
      },
      {
        label: 'Ecological Organisation',
        href: '/clusters/ecological-organisation/',
      },
      {
        label: 'Cognition and Mind',
        href: '/clusters/cognition-and-mind/',
      },
      {
        label: 'Social Organisation',
        href: '/clusters/social-organisation/',
      },
    ],
  },
  {
    heading: 'Evidence and Boundaries',
    items: [
      {
        label: 'Diagnosis and Evidence',
        href: '/clusters/diagnostics-and-empirical-tractability/',
      },
      {
        label: 'Artificial Systems and Boundaries',
        href: '/clusters/artificial-systems-and-boundaries/',
      },
    ],
  },
];

const topicsActive = topicGroups.some((group) =>
  group.items.some((item) => pathname === item.href)
);
---

<nav class="site-nav" aria-label="Main navigation">
  <div class="nav-inner">
    <a href="/" class="nav-brand">
      APS<span>Publishing Platform</span>
    </a>

    <button
      class="nav-toggle"
      id="nav-toggle"
      type="button"
      aria-label="Toggle navigation"
      aria-controls="nav-links"
      aria-expanded="false"
    >
      &#9776;
    </button>

    <ul class="nav-links" id="nav-links">
      {
        navItems.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={
                pathname === item.href ||
                (item.href !== '/' && pathname.startsWith(item.href))
                  ? 'page'
                  : undefined
              }
            >
              {item.label}
            </a>
          </li>
        ))
      }

      <li class="nav-dropdown">
        <button
          class="nav-dropdown-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="topics-menu"
          aria-haspopup="true"
          data-active={topicsActive ? 'true' : undefined}
        >
          Topics <span class="dropdown-arrow" aria-hidden="true">&#9662;</span>
        </button>

        <ul class="nav-dropdown-menu" id="topics-menu">
          {
            topicGroups.map((group) => (
              <li class="topic-group">
                <span class="topic-group-heading">
                  {group.heading}
                </span>

                <ul class="topic-group-links">
                  {group.items.map((item) => (
                    <li>
                      <a
                        href={item.href}
                        aria-current={
                          pathname === item.href ? 'page' : undefined
                        }
                      >
                        {item.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ))
          }
        </ul>
      </li>

      <li>
        <a href="/search/" class="nav-search-btn">
          &#128269; Search
        </a>
      </li>
    </ul>
  </div>
</nav>

<script>
  const navToggle = document.getElementById('nav-toggle');
  const navLinks = document.getElementById('nav-links');

  const closeDropdown = (
    dropdown: Element,
    restoreFocus = false
  ) => {
    const button = dropdown.querySelector<HTMLButtonElement>(
      '.nav-dropdown-toggle'
    );

    dropdown.classList.remove('open');
    button?.setAttribute('aria-expanded', 'false');

    if (restoreFocus) {
      button?.focus();
    }
  };

  navToggle?.addEventListener('click', () => {
    const isOpen = navLinks?.classList.toggle('open') ?? false;

    navToggle.setAttribute(
      'aria-expanded',
      isOpen ? 'true' : 'false'
    );

    if (!isOpen) {
      document.querySelectorAll('.nav-dropdown.open').forEach(
        (dropdown) => closeDropdown(dropdown)
      );
    }
  });

  document.querySelectorAll<HTMLButtonElement>(
    '.nav-dropdown-toggle'
  ).forEach((button) => {
    button.addEventListener('click', (event) => {
      event.stopPropagation();

      const dropdown = button.closest('.nav-dropdown');
      if (!dropdown) return;

      const wasOpen = dropdown.classList.contains('open');

      document.querySelectorAll('.nav-dropdown.open').forEach(
        (other) => closeDropdown(other)
      );

      if (!wasOpen) {
        dropdown.classList.add('open');
        button.setAttribute('aria-expanded', 'true');
      }
    });
  });

  document.addEventListener('click', (event) => {
    const target = event.target;

    if (!(target instanceof Node)) return;

    document.querySelectorAll('.nav-dropdown.open').forEach(
      (dropdown) => {
        if (!dropdown.contains(target)) {
          closeDropdown(dropdown);
        }
      }
    );
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;

    document.querySelectorAll('.nav-dropdown.open').forEach(
      (dropdown) => closeDropdown(dropdown, true)
    );
  });
</script>

<style>
  /*
   * WT-02: Presentation-only grouping.
   * Existing global navigation styles remain authoritative.
   */

  .topic-group {
    list-style: none;
  }

  .topic-group-heading {
    display: block;
    padding: 0.65rem 1rem 0.25rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.045em;
    text-transform: uppercase;
    opacity: 0.7;
    cursor: default;
  }

  .topic-group-links {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .topic-group-links > li {
    list-style: none;
  }

  .topic-group-links a {
    display: block;
  }

  .topic-group + .topic-group {
    border-top: 1px solid currentColor;
    margin-top: 0.4rem;
    padding-top: 0.4rem;
    border-color: rgba(128, 128, 128, 0.2);
  }
</style>
