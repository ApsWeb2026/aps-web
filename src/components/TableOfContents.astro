---
const { headings = [] } = Astro.props;

const items = Array.isArray(headings)
  ? headings.filter((heading) => heading.depth === 2 || heading.depth === "h2")
  : [];
---

{items.length >= 3 ? (
  <nav class="article-toc" aria-label="Article contents">
    <h2>Contents</h2>
    <ol class="article-toc-list">
      {items.map((heading) => (
        <li>
          <a href={`#${heading.slug || heading.id}`}>{heading.text}</a>
        </li>
      ))}
    </ol>
  </nav>
) : null}