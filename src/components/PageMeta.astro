---
import StatusBadge from './StatusBadge.astro';
import TypeBadge from './TypeBadge.astro';

interface Props {
  status: 'draft' | 'evolving' | 'canonical';
  type: 'article' | 'glossary' | 'stream' | 'orientation' | 'diagram' | 'box';
  cluster?: string;
  date?: string;
  revised?: string;
}

const { status, type, cluster, date, revised } = Astro.props;

const domainLabels: Record<string, string> = {
  'conceptual-foundations': 'Foundations',
  'philosophy-of-biology': 'Philosophy',
  'evolutionary-dynamics': 'Evolution',
  'developmental-organisation': 'Development',
  'ecological-organisation': 'Ecology',
  'cognition-and-mind': 'Cognition',
  'social-organisation': 'Sociality',
  'diagnostics-and-empirical-tractability': 'Evidence',
  'methodology-and-explanation': 'Explanation',
  'artificial-systems-and-boundaries': 'Boundaries',
};

function formatDate(value?: string) {
  if (!value) return null;

  return new Date(value).toLocaleDateString('en-AU', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });
}
---

<div class="page-meta">
  <StatusBadge status={status} />
  <TypeBadge type={type} />

  {
    cluster && (
      <>
        <span class="page-meta-divider">|</span>
        <span class="page-meta-item">
          <a href={`/clusters/${cluster}/`}>
            {domainLabels[cluster] || cluster}
          </a>
        </span>
      </>
    )
  }

  {
    date && (
      <>
        <span class="page-meta-divider">|</span>
        <span class="page-meta-item">Created: {formatDate(date)}</span>
      </>
    )
  }

  {
    revised && (
      <>
        <span class="page-meta-divider">|</span>
        <span class="page-meta-item">Revised: {formatDate(revised)}</span>
      </>
    )
  }
</div>