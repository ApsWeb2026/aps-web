---
import {
  resolveReferenceInputs,
  type ReferenceInput,
} from '@/lib/references/retrieval';

interface Props {
  references?: ReferenceInput[];
}

const { references = [] } = Astro.props;

const resolvedReferences = resolveReferenceInputs(references);

function asString(value: unknown): string {
  if (typeof value === 'string') return value;
  if (typeof value === 'number') return String(value);
  return '';
}

function formatContributors(value: unknown): string {
  const text = asString(value).trim();

  if (!text) return '';

  const contributors = text
    .split(';')
    .map((name) => name.trim())
    .filter(Boolean);

  if (contributors.length === 1) {
    return contributors[0];
  }

  if (contributors.length === 2) {
    return `${contributors[0]}, & ${contributors[1]}`;
  }

  return `${contributors.slice(0, -1).join(', ')}, & ${contributors.at(-1)}`;
}

function contributorCount(value: unknown): number {
  const text = asString(value).trim();

  if (!text) return 0;

  return text
    .split(';')
    .map((name) => name.trim())
    .filter(Boolean)
    .length;
}

/*
 * References are displayed alphabetically by contributor name.
 * Where contributor names are unavailable, title is used as fallback.
 * Year provides the secondary sort order.
 */
const sortedReferences = [...resolvedReferences].sort((a, b) => {
  const contributorA =
    asString(a.authors) ||
    asString(a.editors) ||
    asString(a.title);

  const contributorB =
    asString(b.authors) ||
    asString(b.editors) ||
    asString(b.title);

  const contributorComparison = contributorA.localeCompare(
    contributorB,
    'en',
    { sensitivity: 'base' },
  );

  if (contributorComparison !== 0) {
    return contributorComparison;
  }

  const yearComparison = asString(a.year).localeCompare(
    asString(b.year),
  );

  if (yearComparison !== 0) {
    return yearComparison;
  }

  return asString(a.title).localeCompare(
    asString(b.title),
    'en',
    { sensitivity: 'base' },
  );
});
---

{
  sortedReferences.length > 0 && (
    <section class="references-section">
      <h2>References</h2>

      <ol class="ref-list">
        {sortedReferences.map((ref) => {
          const id = asString(ref.id);
          const type = asString(ref.type);

          const authors = formatContributors(ref.authors);
          const editors = formatContributors(ref.editors);
          const contributors = authors || editors;

          const editorSuffix =
            type === 'edited-book' && editors && !authors
              ? contributorCount(ref.editors) > 1
                ? ' (eds.).'
                : ' (ed.).'
              : '';

          const year = asString(ref.year);
          const title = asString(ref.title);
          const journal = asString(ref.journal);
          const source = asString(ref.source ?? ref.publisher);
          const volume = asString(ref.volume);
          const issue = asString(ref.issue);
          const pages = asString(ref.pages);
          const doi = asString(ref.doi);
          const url = asString(ref.url);
          const note = asString(ref.note);

          const isJournal = Boolean(journal);

          return (
            <li class="ref-entry" id={`ref-${id}`}>
              {contributors && (
                <>
                  <span class="ref-authors">
                    {contributors}{editorSuffix}
                  </span>{' '}
                </>
              )}

              ({year}).{' '}

              {isJournal ? (
                <>
                  <span class="ref-title">{title}</span>.{' '}
                  <em>{journal}</em>
                  {volume && <>, {volume}</>}
                  {issue && <>({issue})</>}
                  {pages && <>, {pages}</>}
                  .
                </>
              ) : (
                <>
                  <em class="ref-title">{title}</em>.
                  {source && <> {source}.</>}
                </>
              )}

              {note && <> {note}.</>}

              {doi && (
                <>
                  {' '}
                  <a
                    class="ref-doi"
                    href={`https://doi.org/${doi}`}
                    target="_blank"
                    rel="noopener"
                  >
                    https://doi.org/{doi}
                  </a>
                </>
              )}

              {!doi && url && (
                <>
                  {' '}
                  <a
                    class="ref-url"
                    href={url}
                    target="_blank"
                    rel="noopener"
                  >
                    {url}
                  </a>
                </>
              )}
            </li>
          );
        })}
      </ol>
    </section>
  )
}