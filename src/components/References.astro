---
import {
  resolveReferenceInputs,
  type ReferenceInput,
} from '@/lib/references/retrieval';

interface Props {
  references?: ReferenceInput[];
}

const { references = [] } = Astro.props;

const resolvedReferences = resolveReferenceInputs(references);

function asString(value: unknown): string {
  if (typeof value === 'string') return value;
  if (typeof value === 'number') return String(value);
  return '';
}

const sortedReferences = [...resolvedReferences].sort((a, b) =>
  asString(a.authors).localeCompare(asString(b.authors)) ||
  asString(a.year).localeCompare(asString(b.year))
);
---

{
  sortedReferences.length > 0 && (
    <section class="references">
      <h2>References</h2>

      <ol class="ref-list">
        {sortedReferences.map((ref) => {
          const id = asString(ref.id);
          const authors = asString(ref.authors);
          const year = asString(ref.year);
          const title = asString(ref.title);
          const journal = asString(ref.journal);
          const source = asString(ref.source ?? ref.publisher);
          const volume = asString(ref.volume);
          const issue = asString(ref.issue);
          const pages = asString(ref.pages);
          const doi = asString(ref.doi);
          const url = asString(ref.url);
          const note = asString(ref.note);

          const isJournal = Boolean(journal);

          return (
            <li class="ref-entry" id={`ref-${id}`}>
              <span class="ref-authors">{authors}</span> ({year}).{' '}

              {isJournal ? (
                <>
                  <span class="ref-title">{title}</span>.{' '}
                  <em>{journal}</em>
                  {volume && <>, {volume}</>}
                  {issue && <>({issue})</>}
                  {pages && <>, {pages}</>}
                  .
                </>
              ) : (
                <>
                  <em class="ref-title">{title}</em>.
                  {source && <> {source}.</>}
                </>
              )}

              {note && <> {note}.</>}

              {doi && (
                <>
                  {' '}
                  <a
                    class="ref-doi"
                    href={`https://doi.org/${doi}`}
                    target="_blank"
                    rel="noopener"
                  >
                    https://doi.org/{doi}
                  </a>
                </>
              )}

              {!doi && url && (
                <>
                  {' '}
                  <a
                    class="ref-url"
                    href={url}
                    target="_blank"
                    rel="noopener"
                  >
                    {url}
                  </a>
                </>
              )}
            </li>
          );
        })}
      </ol>
    </section>
  )
}