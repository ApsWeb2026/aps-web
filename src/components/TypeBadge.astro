---
interface Props {
  type:
    | 'article'
    | 'glossary'
    | 'stream'
    | 'orientation'
    | 'diagram'
    | 'box'
    | 'anchor'
    | 'synthesis'
    | 'core'
    | 'clarification'
    | 'extension';
}

const { type } = Astro.props;

const labels: Record<string, string> = {
  article: 'Article',
  glossary: 'Glossary',
  stream: 'Stream',
  orientation: 'Orientation',
  diagram: 'Diagram',
  box: 'APS Box',

  anchor: 'Anchor',
  synthesis: 'Synthesis',
  core: 'Core',
  clarification: 'Clarification',
  extension: 'Extension',
};
---

<span class={`badge badge-type badge-${type}`}>{labels[type]}</span>
