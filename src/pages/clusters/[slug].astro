    <Breadcrumb
      items={[
        { label: 'Clusters' },
        { label: cluster.title },
      ]}
    />

    <header class="cluster-header">
      <h1>{cluster.title}</h1>

      <p class="cluster-description">
        {cluster.description}
      </p>

       <p class="cluster-overview">
        {cluster.overview}
      </p>

      {
  cluster.architectureGuide && (
    <section class="domain-architecture-guide">
      <h2>Start with the Architecture</h2>

      <p>
        Before exploring individual concepts, readers should begin with the
        architectural overview of the APS framework.
      </p>

      <div class="card">
        <div class="card-header">
          <h3 class="card-title">
            <a href={cluster.architectureGuide.href}>
              {cluster.architectureGuide.title}
            </a>
          </h3>

          <TypeBadge type="orientation" />
        </div>

        <p class="card-excerpt">
          {cluster.architectureGuide.description}
        </p>
      </div>
    </section>
  )
}
Result

      {
        cluster.startHere && (
          <section class="domain-start-here">
            <h2>Start Here</h2>

            <p>
              New to this domain? These articles provide the quickest route into the
              central APS ideas.
            </p>

            <ol>
              {cluster.startHere.map((item) => (
                <li>{item}</li>
              ))}
            </ol>
          </section>
        )
      }

      {
        cluster.keyQuestions && (
          <section class="domain-key-questions">
            <h2>Key Questions</h2>

            <ul>
              {cluster.keyQuestions.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </section>
        )
      }

      {
        cluster.architecture && (
        <section class="cluster-architecture">
          <div set:html={cluster.architecture} />
        </section>
      )
    }

      <aside class="cluster-boundary-note">
        <strong>Cluster note:</strong> {cluster.boundary}
      </aside>
    </header>

    {
  groupedArticles.length > 0 && (
    <section class="home-section">
      <h2>Articles</h2>

      {groupedArticles.map((group) => (
        <section class="article-role-group">
          <h3>{group.title}</h3>

          <ul class="card-list">
            {group.articles.map((entry) => (
              <li class="card">
                <div class="card-header">
                  <h3 class="card-title">
                    <a href={`/articles/${entry.data.slug}/`}>
                      {entry.data.title}
                    </a>
                  </h3>

                  <DomainBadge cluster={entry.data.cluster} />

                  {entry.data.role && <TypeBadge type={entry.data.role} />}
                </div>

                <p class="card-excerpt">
                  {entry.data.abstract}
                </p>

                <div class="card-meta">
                  Revised: {entry.data.revised}
                </div>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </section>
  )
}

    {
      glossaryEntries.length > 0 && (
        <section class="home-section">
          <h2>Glossary Entries</h2>

          <ul class="card-list">
            {glossaryEntries.map((entry) => (
              <li class="card">
                <div class="card-header">
                  <h3 class="card-title">
                    <a href={`/glossary/${entry.data.slug}/`}>
                      {entry.data.title}
                    </a>
                  </h3>

                  <DomainBadge cluster={entry.data.cluster} />
                  <TypeBadge type="glossary" />
                </div>

                <p class="card-excerpt">
                  {entry.data.inBrief}
                </p>

                <div class="card-meta">
                  Revised: {entry.data.revised}
                </div>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      streams.length > 0 && (
        <section class="home-section">
          <h2>Research Streams</h2>

          <ul class="card-list">
            {streams.map((entry) => (
              <li class="card">
                <div class="card-header">
                  <h3 class="card-title">
                    <a href={`/streams/${entry.data.slug}/`}>
                      {entry.data.title}
                    </a>
                  </h3>

                  <StatusBadge status={entry.data.status} />
                  <TypeBadge type="stream" />
                </div>

                <p class="card-excerpt">
                  {entry.data.overview}
                </p>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      articles.length === 0 &&
        glossaryEntries.length === 0 &&
        streams.length === 0 && (
          <p>
            No content has been published in this cluster yet.
            Check back soon.
          </p>
        )
    }
  </div>
</BaseLayout>