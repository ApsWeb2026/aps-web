---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import StatusBadge from '@/components/StatusBadge.astro';
import TypeBadge from '@/components/TypeBadge.astro';

const clusters = [
  {
    slug: 'conceptual-foundations',
    title: 'Conceptual Foundations',
    description:
      'Core APS concepts including agency, process, scale, viability, persistence, and biological organisation.',
    overview:
      'This cluster contains the framework-wide concepts from which APS is constructed. It explains the basic architecture of life as viability-oriented, organised persistence sustained across time.',
    boundary:
      'Some concepts placed here have important implications elsewhere. Normativity connects to cognition and social organisation, while scale, coupling, continuity, and process recur throughout development, ecology, evolution, and diagnosis. They are placed here when APS treats them as general organisational principles rather than domain-specific phenomena.',
  },
  {
    slug: 'evolutionary-dynamics',
    title: 'Evolutionary Dynamics',
    description:
      'Evolution, inheritance, adaptation, variation, fitness, species, and the historical transformation of organised persistence.',
    overview:
      'This cluster examines how organised persistence is transformed across generations and lineages. APS treats evolution as the historical reorganisation of living systems rather than as a process reducible to genes, traits, or selection alone.',
    boundary:
      'Some evolutionary concepts overlap with development, ecology, and social organisation. Inheritance, variation, adaptation, fitness, and species are placed here when their primary role concerns lineage continuity, differential persistence, and historical biological transformation.',
  },
  {
    slug: 'developmental-organisation',
    title: 'Developmental Organisation',
    description:
      'Development, continuity, plasticity, robustness, regulation, morphology, physiology, ageing, and organised persistence across transformation.',
    overview:
      'This cluster examines how living systems maintain continuity through growth, repair, transformation, ageing, and material change. APS treats development as organised persistence across a life history rather than as the execution of a programme.',
    boundary:
      'Developmental concepts often draw on foundational ideas such as process, continuity, viability, and temporal organisation. They are placed here when the main issue is how an individual living system maintains or reconstructs itself through developmental change.',
  },
  {
    slug: 'ecological-organisation',
    title: 'Ecological Organisation',
    description:
      'Ecology, environment, niche, organism–environment coupling, resilience, ecosystems, and persistence across ecological relations.',
    overview:
      'This cluster examines how living systems persist through relations with environments, niches, ecosystems, and other organisms. APS treats ecological organisation as a continuity architecture, not merely as an external setting for organisms.',
    boundary:
      'Ecological concepts often overlap with cognition and evolution. Affordance and Umwelt are placed in Cognition and Mind because APS treats them primarily as meaning-related concepts, while environment, niche, ecosystem, and ecological resilience belong here because their main role concerns ecological organisation.',
  },
  {
    slug: 'cognition-and-mind',
    title: 'Cognition and Mind',
    description:
      'Evaluation, semiosis, meaning, information, representation, communication, cognition, consciousness, affordance, and Umwelt.',
    overview:
      'This cluster examines how meaningful, information-bearing, semiotic, and cognitive relations emerge within viability-oriented systems. APS treats cognition as grounded in agency, evaluation, and biological meaning rather than as an isolated mental capacity.',
    boundary:
      'Several concepts in this cluster sit at the boundary between cognition and ecology. Affordance and Umwelt concern organism–environment relations, but they are placed here because APS treats them primarily as concepts of meaning, evaluation, and agency. Evaluation is also foundational, but it is placed here because it forms the bridge from agency to meaning, information, semiosis, and cognition.',
  },
  {
    slug: 'social-organisation',
    title: 'Social Organisation',
    description:
      'Social organisation, collective agency, cultural continuity, institutions, norms, cooperation, symbolic coordination, and persistence beyond the individual organism.',
    overview:
      'This cluster examines how organised persistence extends into social, cultural, institutional, and symbolic forms. APS treats social organisation as a continuity architecture built from shared norms, practices, meanings, and coordinated activity.',
    boundary:
      'Social concepts often overlap with cognition and evolution. Communication and meaning belong primarily to Cognition and Mind, while culture, cultural inheritance, social norms, institutions, symbolic coordination, and social continuity belong here when their main role concerns the persistence of social organisation.',
  },
  {
    slug: 'diagnostics-and-empirical-tractability',
    title: 'Diagnostics and Empirical Tractability',
    description:
      'Perturbation, malfunction, diagnosis, biosignatures, life detection, evidence, failure, and operational analysis of living systems.',
    overview:
      'This cluster examines how APS concepts become empirically tractable. It concerns how living organisation is identified, tested, diagnosed, and distinguished from breakdown, malfunction, or non-living organisation.',
    boundary:
      'Diagnostic concepts often depend on foundational ideas such as viability, organisation, persistence, and continuity. They are placed here when the main issue is how those forms of organisation are recognised, evidenced, perturbed, or operationally assessed.',
  },
  {
    slug: 'philosophy-of-biology',
    title: 'Philosophy of Biology',
    description:
      'Philosophical foundations, realism, reductionism, mechanism, holism, organicism, teleology, historical context, and conceptual clarification.',
    overview:
      'This cluster examines the philosophical traditions, debates, and interpretive problems with which APS engages. It situates APS in relation to reductionism, mechanism, holism, organicism, teleology, realism, and broader philosophy of biology.',
    boundary:
      'Some concepts here have close methodological or foundational connections. Teleology is placed here as a philosophical debate, while teleonomy, purpose, function, and normativity belong in Conceptual Foundations when they express APS’s positive biological account of purposive organisation.',
  },
  {
    slug: 'methodology-and-explanation',
    title: 'Methodology and Explanation',
    description:
      'Explanatory structure, conceptual grammar, classification, causation, theory construction, and the organisation of biological explanation.',
    overview:
      'This cluster examines how biological explanation should be structured. APS distinguishes description from explanation and asks what biological explanations must explain if they are to account for viability-oriented organised persistence.',
    boundary:
      'Methodological concepts often overlap with foundations and philosophy. Causation, classification, emergence, explanatory direction, explanatory grammar, and counterfactual depth are placed here when their main role concerns explanatory practice rather than the biological organisation being explained.',
  },
  {
   slug: 'artificial-systems-and-boundaries',
   title: 'Artificial Systems and Boundaries',
   description:
    'Artificial systems, AI, borderline cases, minimal life, synthetic systems, and the limits of biological organisation.',
   overview:
    'This cluster examines cases that test the boundaries of APS. It considers artificial systems, AI, minimal life, synthetic biology, borderline organisation, and systems that resemble life without necessarily possessing biological agency.',

   architecture: `
## How This Cluster Is Organised

This cluster is organised around a central question: how should living systems be distinguished from artificial, simulated, and borderline forms of organisation?

The anchor article, *The Boundaries of Life*, establishes the APS account of biological boundaries and provides the conceptual framework for the cluster as a whole. It explains why APS defines life in terms of viability-oriented organised persistence and why boundary questions are ultimately questions about organisation rather than superficial similarity.

The remaining articles develop this framework through four connected explanatory pathways.

### Definition and Diagnosis

These articles explain what life is and how living organisation can be recognised, diagnosed, and investigated. They establish the conceptual and empirical criteria through which APS approaches questions of life detection, biological identification, and evidential assessment.

### Borderline Cases

These articles examine difficult cases such as viruses, dormancy, minimal life, protocells, and other systems that challenge conventional distinctions between living and non-living organisation. Their purpose is not simply to classify unusual systems, but to clarify which forms of organisation are necessary for viability-oriented persistence.

### Artificial Systems

These articles investigate artificial intelligence, computation, artificial life, and related systems that may resemble living systems in some respects while lacking biological agency. They clarify why simulation, information processing, behavioural complexity, and adaptive performance are not by themselves sufficient for life.

### Integration and Clarification

These articles reconnect boundary questions to the wider APS framework. They show how agency, organisation, persistence, diagnosis, cognition, and biological explanation together help clarify the limits of living organisation and the distinction between life, life-like systems, and artificial systems.

### Suggested Reading Pathway

Readers new to APS should begin with *The Boundaries of Life*. From there, the cluster progresses naturally from definition and diagnosis to borderline cases and finally to artificial systems. Together these articles provide a systematic account of how APS distinguishes living, artificial, and life-like forms of organisation.
`,

   boundary:
    'Boundary cases often draw on diagnostics, cognition, and conceptual foundations. They are placed here when the main issue is whether a system should count as living, agentive, cognitive, artificial, or merely life-like under APS criteria.',
  },
  ];

export function getStaticPaths() {
  return [
    { params: { slug: 'conceptual-foundations' } },
    { params: { slug: 'evolutionary-dynamics' } },
    { params: { slug: 'developmental-organisation' } },
    { params: { slug: 'ecological-organisation' } },
    { params: { slug: 'cognition-and-mind' } },
    { params: { slug: 'social-organisation' } },
    { params: { slug: 'diagnostics-and-empirical-tractability' } },
    { params: { slug: 'methodology-and-explanation' } },
    { params: { slug: 'philosophy-of-biology' } },
    { params: { slug: 'artificial-systems-and-boundaries' } },
  ];
}

const { slug } = Astro.params;
const cluster = clusters.find((c) => c.slug === slug)!;

const articles = (await getCollection('articles')).filter(
  (a) => a.data.cluster === slug,
);

const glossaryEntries = (await getCollection('glossary')).filter(
  (g) => g.data.cluster === slug,
);

const streams = (await getCollection('streams')).filter(
  (s) => s.data.cluster === slug,
);

const statusOrder: Record<string, number> = {
  canonical: 0,
  evolving: 1,
  draft: 2,
};

articles.sort(
  (a, b) =>
    (statusOrder[a.data.status] ?? 9) -
      (statusOrder[b.data.status] ?? 9) ||
    a.data.title.localeCompare(b.data.title),
);

glossaryEntries.sort(
  (a, b) =>
    (statusOrder[a.data.status] ?? 9) -
      (statusOrder[b.data.status] ?? 9) ||
    a.data.title.localeCompare(b.data.title),
);

streams.sort(
  (a, b) =>
    (statusOrder[a.data.status] ?? 9) -
      (statusOrder[b.data.status] ?? 9) ||
    a.data.title.localeCompare(b.data.title),
);
---

<BaseLayout title={cluster.title} description={cluster.description}>
  <div class="content-wrapper">
    <Breadcrumb
      items={[
        { label: 'Clusters' },
        { label: cluster.title },
      ]}
    />

    <header class="cluster-header">
      <h1>{cluster.title}</h1>

      <p class="cluster-description">
        {cluster.description}
      </p>

      <p class="cluster-overview">
        {cluster.overview}
      </p>

    {
      cluster.architecture && (
        <section class="cluster-architecture">
          <div set:html={cluster.architecture} />
        </section>
      )
    }

      <aside class="cluster-boundary-note">
        <strong>Cluster note:</strong> {cluster.boundary}
      </aside>
    </header>

    {
      articles.length > 0 && (
        <section class="home-section">
          <h2>Articles</h2>

          <ul class="card-list">
            {articles.map((entry) => (
              <li class="card">
                <div class="card-header">
                  <h3 class="card-title">
                    <a href={`/articles/${entry.data.slug}/`}>
                      {entry.data.title}
                    </a>
                  </h3>

                  <StatusBadge status={entry.data.status} />
                  <TypeBadge type="article" />
                </div>

                <p class="card-excerpt">
                  {entry.data.abstract}
                </p>

                <div class="card-meta">
                  Revised: {entry.data.revised}
                </div>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      glossaryEntries.length > 0 && (
        <section class="home-section">
          <h2>Glossary Entries</h2>

          <ul class="card-list">
            {glossaryEntries.map((entry) => (
              <li class="card">
                <div class="card-header">
                  <h3 class="card-title">
                    <a href={`/glossary/${entry.data.slug}/`}>
                      {entry.data.title}
                    </a>
                  </h3>

                  <StatusBadge status={entry.data.status} />
                  <TypeBadge type="glossary" />
                </div>

                <p class="card-excerpt">
                  {entry.data.inBrief}
                </p>

                <div class="card-meta">
                  Revised: {entry.data.revised}
                </div>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      streams.length > 0 && (
        <section class="home-section">
          <h2>Research Streams</h2>

          <ul class="card-list">
            {streams.map((entry) => (
              <li class="card">
                <div class="card-header">
                  <h3 class="card-title">
                    <a href={`/streams/${entry.data.slug}/`}>
                      {entry.data.title}
                    </a>
                  </h3>

                  <StatusBadge status={entry.data.status} />
                  <TypeBadge type="stream" />
                </div>

                <p class="card-excerpt">
                  {entry.data.overview}
                </p>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      articles.length === 0 &&
        glossaryEntries.length === 0 &&
        streams.length === 0 && (
          <p>
            No content has been published in this cluster yet.
            Check back soon.
          </p>
        )
    }
  </div>
</BaseLayout>