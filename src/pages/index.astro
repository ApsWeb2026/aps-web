---
import BaseLayout from '@/layouts/BaseLayout.astro';

interface HomeCard {
  title: string;
  description: string;
  href: string;
}

interface QuestionComparison {
  title: string;
  familiarQuestion: string;
  apsQuestion: string;
  explanation: string;
}

const startHereCards: HomeCard[] = [
  {
    title: 'What Is Biology Trying to Explain?',
    description:
      'Begin with biology’s central explanatory question and why it matters to the relationships among different biological explanations.',
    href: '/articles/what-is-biology-trying-to-explain/',
  },
  {
    title: 'What Is a Biological System?',
    description:
      'Explore what distinguishes living organisation and why the maintenance of viability matters.',
    href: '/articles/what-is-a-biological-system/',
  },
  {
    title: 'What Is APS?',
    description:
      'An accessible introduction to agency, process and scale as complementary perspectives on living organisation.',
    href: '/orientation/what-is-aps/',
  },
];

const questionComparisons: QuestionComparison[] = [
  {
    title: 'Function',
    familiarQuestion: 'What does this trait, process, or structure do?',
    apsQuestion: 'How does it contribute to maintaining viability-oriented biological organisation?',
    explanation:
      'APS examines function as a present-tense, viability-relative organisational contribution, while distinguishing this from explanations of how the function arose.',
  },
  {
    title: 'Development',
    familiarQuestion: 'How does an organism develop?',
    apsQuestion: 'How is viable biological organisation reorganised across an individual life history?',
    explanation:
      'APS investigates continuity through developmental transformation without replacing the mechanisms that explain particular developmental processes.',
  },
  {
    title: 'Evolution',
    familiarQuestion: 'How do biological populations change across generations?',
    apsQuestion: 'How are forms of organised persistence historically transformed?',
    explanation:
      'APS examines how organised persistence relates to inheritance, variation and evolutionary change without displacing established evolutionary explanations.',
  },
];

const domainCards: HomeCard[] = [
  {
    title: 'Cognition and Mind',
    description:
      'Biological significance, evaluation, integration and the conditions under which biological activity may be cognitive.',
    href: '/clusters/cognition-and-mind/',
  },
  {
    title: 'Developmental Organisation',
    description: 'Continuity, transformation, regeneration and repair across development.',
    href: '/clusters/developmental-organisation/',
  },
  {
    title: 'Evolutionary Dynamics',
    description: 'Inheritance, variation, adaptation and historical change across generations.',
    href: '/clusters/evolutionary-dynamics/',
  },
  {
    title: 'Ecological Organisation',
    description: 'Organism–environment relationships, ecological dependencies and viability across scales.',
    href: '/clusters/ecological-organisation/',
  },
  {
    title: 'Social Organisation',
    description: 'Coordination, collective activity and relationships among biological participants.',
    href: '/clusters/social-organisation/',
  },
];

const furtherTopics: HomeCard[] = [
  {
    title: 'Conceptual Foundations',
    description: 'The principal concepts and architecture of APS.',
    href: '/clusters/conceptual-foundations/',
  },
  {
    title: 'Methodology and Explanation',
    description: 'How explanatory claims are specified, compared and tested.',
    href: '/clusters/methodology-and-explanation/',
  },
  {
    title: 'Philosophy of Biology',
    description: 'Biological organisation, normativity and philosophical interpretation.',
    href: '/clusters/philosophy-of-biology/',
  },
  {
    title: 'Diagnosis and Evidence',
    description: 'Evidence, diagnostic distinctions and empirical assessment.',
    href: '/clusters/diagnostics-and-empirical-tractability/',
  },
  {
    title: 'Artificial Systems and Boundaries',
    description: 'The limits of biological concepts and comparisons with artificial systems.',
    href: '/clusters/artificial-systems-and-boundaries/',
  },
];
---

<BaseLayout
  title="Home"
  description="Explore Agency–Process–Scale (APS), a proposed integrative analytic framework for theoretical biology, its explanatory questions, scientific assessment, and research pathways."
>
  <div class="content-wrapper">
    <header class="hero">
      <h1>
        Biology explains many things.
        <br />
        <span>But what is biology itself trying to explain?</span>
      </h1>

      <p class="subtitle">
        Evolution. Development. Function. Agency. Ecology. Biological organisation.
      </p>

      <p class="hero-guidance">
        Each area of biology has its own questions, methods, and explanatory achievements.
        Together they raise a wider question: how do these different explanations relate?
      </p>

      <p class="hero-guidance">
        Agency–Process–Scale (APS) investigates this question as a proposed integrative
        framework for theoretical biology. It seeks to clarify relationships among biological
        concepts without replacing established theories or presuming explanatory superiority.
      </p>

      <div class="hero-links" aria-label="Homepage starting points">
        <a href="/#start-here-heading" class="btn btn-primary">Start Here</a>
        <a href="/articles/why-aps/" class="btn btn-secondary">Why APS?</a>
        <a href="/biologys-big-questions/" class="btn btn-secondary">
          Explore Biology’s Big Questions
        </a>
      </div>
    </header>

    <section class="home-section" aria-labelledby="start-here-heading">
      <h2 id="start-here-heading">Start Here</h2>
      <div class="article-text-block">
        <p>
          APS can be approached through a few introductory questions. These pathways introduce
          the biological problem, what distinguishes living systems, and the structure of the framework.
        </p>
      </div>

      <ul class="card-list">
        {startHereCards.map((resource) => (
          <li class="card">
            <div class="card-header">
              <h3 class="card-title"><a href={resource.href}>{resource.title}</a></h3>
              <span class="badge badge-type badge-orientation">Start Here</span>
            </div>
            <p class="card-excerpt">{resource.description}</p>
          </li>
        ))}
      </ul>

      <p>
        For a wider guide to the website’s concepts, domains, and reading pathways, see
        <a href="/orientation/understanding-aps-the-structure-of-the-framework/">
          Understanding APS: The Structure of the Framework
        </a>.
      </p>
    </section>

    <section class="home-section architecture-diagram-section" aria-labelledby="what-is-aps-heading">
      <div class="article-text-block">
        <h2 id="what-is-aps-heading">What Is APS?</h2>
        <p>
          APS stands for <strong>Agency–Process–Scale</strong>. It investigates living systems
          through three complementary analytic projections, not three separate biological
          entities, independent causes, or hierarchical levels.
        </p>
        <p>
          APS proposes that life is characterised by <strong>viability-oriented,
          constraint-closed organisation</strong>: living systems participate in sustaining
          the conditions that make their continued existence possible. This organisation
          is enacted through activity, unfolds through processes, and can be investigated
          across spatial, temporal, and organisational scales.
        </p>
        <h3>Organised Persistence</h3>
        <p>
          Living systems grow, develop, repair, reproduce, and respond to changing circumstances.
          Their persistence is therefore <strong>continuity maintained through change</strong>,
          not changeless endurance. APS investigates this organised persistence as a candidate
          comparative explanatory target where it is relevant to the biological question at hand.
          It does not assume that all biological phenomena share one explanation.
        </p>
      </div>

      <div class="aps-framework-content">
        <ul class="card-list">
          <li class="card">
            <div class="card-header"><h3 class="card-title">Agency</h3></div>
            <p class="card-excerpt"><strong>What do living systems do?</strong></p>
            <p class="card-excerpt">
              Biological agency is viability-oriented organisational activity: the present-tense
              activity through which living systems maintain and re-establish the conditions of their
              persistence.
            </p>
          </li>
          <li class="card">
            <div class="card-header"><h3 class="card-title">Process</h3></div>
            <p class="card-excerpt"><strong>How is continuity maintained through change?</strong></p>
            <p class="card-excerpt">
              APS examines the processes through which biological organisation remains continuous amid
              material turnover, development, repair, environmental variation, ageing, and evolutionary
              transformation.
            </p>
          </li>
          <li class="card">
            <div class="card-header"><h3 class="card-title">Scale</h3></div>
            <p class="card-excerpt"><strong>Where is persistence organised?</strong></p>
            <p class="card-excerpt">
              APS investigates where persistence is organised across spatial and temporal extents, and
              how materially implemented relations alter the causal contexts within which local
              biological activity occurs.
            </p>
          </li>
        </ul>

        <figure class="aps-diagram aps-diagram-large">
          <a href="/assets/diagrams/aps-foundational-framework.png" target="_blank" rel="noopener">
            <img
              src="/assets/diagrams/aps-foundational-framework.png"
              alt="Diagram showing Agency, Process, and Scale as complementary analytic projections through which different biological explanations can be related by their contribution to organised persistence."
              loading="lazy"
              decoding="async"
            />
          </a>
          <figcaption class="diagram-caption">
            APS does not replace contemporary biological theories. It uses Agency, Process, and Scale as
            complementary analytic projections for investigating how their distinctive explanatory
            achievements may relate to the organisation and persistence of living systems. Comparative
            explanatory methodology provides the independent means by which such proposed relationships can
            be assessed.
          </figcaption>
        </figure>
        <p class="diagram-hint">Open the diagram to view a larger version.</p>
      </div>

      <p style="text-align: center;">
        Further reading:
        <a href="/orientation/the-core-structure-of-aps-how-the-framework-fits-together/">
          The Core Structure of APS
        </a>.
      </p>
    </section>

    <section class="home-section" aria-labelledby="aps-in-action-heading">
      <h2 id="aps-in-action-heading">APS in Action</h2>
      <div class="article-text-block">
        <p>
          APS does not replace established biological explanations. It asks whether examining
          their relationships through living organisation, viability, and persistence can clarify
          particular questions. Three examples illustrate this approach.
        </p>
      </div>

      <ul class="card-list">
        {questionComparisons.map((item) => (
          <li class="card">
            <div class="card-header"><h3 class="card-title">{item.title}</h3></div>
            <p class="card-excerpt">
              <strong>A familiar biological question</strong><br />
              {item.familiarQuestion}
            </p>
            <p class="card-excerpt">
              <strong>APS also asks</strong><br />
              {item.apsQuestion}
            </p>
            <p class="card-excerpt">{item.explanation}</p>
          </li>
        ))}
      </ul>

      <p>
        These examples suggest possible connections; they do not establish that APS offers
        a better explanation. For additional examples involving agency and ecology, read
        <a href="/articles/why-aps-reframes-biology/">Why APS Reframes Biology</a>.
      </p>
    </section>

    <section class="home-section" aria-labelledby="contemporary-biology-heading">
      <h2 id="contemporary-biology-heading">APS in Contemporary Biology</h2>
      <div class="article-text-block">
        <p>
          Modern biology succeeds through explanatory plurality. Mechanistic, evolutionary,
          developmental, ecological, informational, physiological, mathematical, and organisational
          approaches address different questions and achieve different kinds of understanding.
        </p>
        <p>
          APS investigates whether important relationships among biological concepts and explanations
          can be made more precise, systematic, and assessable through a shared organisational
          perspective. Its proposed contribution may lie in conceptual clarification and cross-domain
          integration, not necessarily in discovering new biological principles.
        </p>
        <p>
          This possibility remains a research question. APS distinguishes conceptual coherence from
          empirical adequacy, and clarification from demonstrated explanatory gain. A claim of
          comparative advantage must address the same explanatory target as the strongest relevant
          alternative and establish a difference beyond redescription or vocabulary.
        </p>
        <p>
          APS is being investigated as a <strong>candidate general explanatory framework for
          biology</strong>. Research to date supports bounded architectural coherence and integration;
          it has not established framework-wide empirical adequacy or comparative explanatory
          superiority. The APS research programme records positive, qualified, null, and adverse
          findings rather than assuming its own success.
        </p>
      </div>

      <aside class="card" aria-labelledby="published-anchor-heading">
        <div class="card-header">
          <h3 id="published-anchor-heading" class="card-title">Published scientific anchor</h3>
          <span class="badge badge-type badge-article">Peer-reviewed publication</span>
        </div>
        <p class="card-excerpt">
          <cite>Agency as the Defining Activity of Life: A Viability-Oriented Framework Integrating
          Process and Scale</cite>, published in <cite>Biological Theory</cite>, presents the
          foundational APS account. The continuing research programme investigates its explanatory
          methods, applications, limitations, and claims.
        </p>
      </aside>

      <p>
        For comparison with other explanatory approaches, see
        <a href="/articles/aps-and-contemporary-theories/">APS and Contemporary Theories</a>.
        The <a href="/clusters/methodology-and-explanation/">Methodology and Explanation</a>
        Topic develops the criteria used to assess explanatory claims.
      </p>

      <div class="hero-links" aria-label="Research and publications">
        <a href="/research/" class="btn btn-primary">Explore APS Research</a>
        <a href="/publications/" class="btn btn-secondary">View Publications</a>
      </div>
    </section>

    <section class="home-section" aria-labelledby="explore-aps-heading">
      <h2 id="explore-aps-heading">Explore APS</h2>
      <div class="article-text-block">
        <p>
          APS is organised into connected areas of inquiry. The Topics pages guide readers to
          their principal concepts, articles, and research questions. These domains are not
          stages in a hierarchy or parts of a universal causal sequence; relationships between
          them must be established for each explanatory question.
        </p>
      </div>

      <h3>Biological Domains</h3>
      <ul class="card-list">
        {domainCards.map((domain) => (
          <li class="card">
            <div class="card-header">
              <h3 class="card-title"><a href={domain.href}>{domain.title}</a></h3>
            </div>
            <p class="card-excerpt">{domain.description}</p>
          </li>
        ))}
      </ul>

      <h3>Foundations, Methods, and Further Reading</h3>
      <ul class="card-list">
        {furtherTopics.map((topic) => (
          <li class="card">
            <div class="card-header">
              <h3 class="card-title"><a href={topic.href}>{topic.title}</a></h3>
            </div>
            <p class="card-excerpt">{topic.description}</p>
          </li>
        ))}
      </ul>

      <p>
        Browse the full <a href="/articles/">Articles directory</a>, consult the
        <a href="/glossary/"> Glossary</a>, or use <a href="/search/">site search</a>
        for more specialised material, including philosophical discussions and clarifications.
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  .aps-framework-content {
    width: 100%;
    max-width: 760px;
    margin-inline: auto;
  }

  .aps-framework-content .card-list {
    width: 100%;
  }

  .aps-framework-content .aps-diagram {
    width: 100%;
    margin: 2.5rem auto 0;
    text-align: center;
  }

  .aps-framework-content .aps-diagram a {
    display: block;
    width: 100%;
  }

  .aps-framework-content .aps-diagram img {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    margin-inline: auto;
  }

  .aps-framework-content .diagram-caption {
    max-width: 700px;
    margin: 1rem auto 0;
    text-align: left;
  }

  .aps-framework-content .diagram-hint {
    text-align: center;
  }
</style>
