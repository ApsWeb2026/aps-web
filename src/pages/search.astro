---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Search" description="Search across all APS content.">
  <div class="content-wrapper">
    <h1>Search</h1>

    <p class="search-hint">
      Full-text search across APS articles, glossary entries, boxes, and orientation pages.
    </p>

    <input
      id="search-input"
      class="search-input"
      type="search"
      placeholder="Search APS..."
      autofocus
    />

    <div id="search-results-count" class="search-results-count" style="display:none;"></div>
    <div id="search-results" class="search-results"></div>
    <div id="search-empty" class="search-empty" style="display:none;">
      <p>No results found. Try a different search term.</p>
    </div>
  </div>
</BaseLayout>

<script is:inline type="module">
  const pagefind = await import('/pagefind/pagefind.js');
  await pagefind.init();

  const input = document.getElementById('search-input');
  const resultsContainer = document.getElementById('search-results');
  const resultsCount = document.getElementById('search-results-count');
  const emptyState = document.getElementById('search-empty');

  const domainLabels = {
    'conceptual-foundations': 'Foundations',
    'philosophy-of-biology': 'Philosophy',
    'evolutionary-dynamics': 'Evolution',
    'developmental-organisation': 'Development',
    'ecological-organisation': 'Ecology',
    'cognition-and-mind': 'Cognition',
    'social-organisation': 'Sociality',
    'diagnostics-and-empirical-tractability': 'Evidence',
    'methodology-and-explanation': 'Explanation',
    'artificial-systems-and-boundaries': 'Boundaries',
  };

  const roleLabels = {
    anchor: 'Anchor',
    synthesis: 'Synthesis',
    core: 'Core',
    clarification: 'Clarification',
    extension: 'Extension',
  };

  const typeOrder = {
    Glossary: 0,
    Article: 1,
    Orientation: 2,
    Box: 3,
    Diagram: 4,
    Stream: 5,
  };

  let debounceTimer;

  const params = new URLSearchParams(window.location.search);
  const initialQuery = params.get('q');

  if (initialQuery) {
    input.value = initialQuery;
    performSearch();
  }

  input.addEventListener('input', () => {
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(performSearch, 200);
  });

  async function performSearch() {
    const query = input.value.trim();

    if (!query) {
      resultsContainer.innerHTML = '';
      resultsCount.style.display = 'none';
      emptyState.style.display = 'none';
      return;
    }

    const search = await pagefind.search(query);

    if (!search.results.length) {
      resultsContainer.innerHTML = '';
      resultsCount.style.display = 'none';
      emptyState.style.display = 'block';
      return;
    }

    const results = await Promise.all(search.results.slice(0, 40).map((r) => r.data()));
    const queryLower = query.toLowerCase();

    results.sort((a, b) => {
      const aTitle = ((a.meta && a.meta.title) || '').toLowerCase();
      const bTitle = ((b.meta && b.meta.title) || '').toLowerCase();

      const aTitleMatch = aTitle.includes(queryLower) ? 0 : 1;
      const bTitleMatch = bTitle.includes(queryLower) ? 0 : 1;

      if (aTitleMatch !== bTitleMatch) return aTitleMatch - bTitleMatch;

      const aType = (a.meta && a.meta.type) || '';
      const bType = (b.meta && b.meta.type) || '';

      return (typeOrder[aType] ?? 9) - (typeOrder[bType] ?? 9);
    });

    emptyState.style.display = 'none';
    resultsCount.style.display = 'block';
    resultsCount.innerHTML =
      'Showing <strong>' +
      results.length +
      '</strong> result' +
      (results.length !== 1 ? 's' : '') +
      ' for "<strong>' +
      escapeHtml(query) +
      '</strong>"';

    resultsContainer.innerHTML = results.map(renderResult).join('');
  }

  function renderResult(result) {
    const meta = result.meta || {};
    const title = meta.title || result.url;
    const type = meta.type || 'Page';
    const cluster = meta.cluster || '';
    const role = meta.role || '';
    const revised = meta.revised || '';
    const excerpt = result.excerpt || '';

    const typeBadge = `
      <span class="badge badge-type badge-${slugify(type)}">
        ${escapeHtml(type)}
      </span>
    `;

    const domainBadge = cluster
      ? `
        <span class="badge badge-domain badge-domain-${escapeHtml(cluster)}">
          ${escapeHtml(domainLabels[cluster] || cluster)}
        </span>
      `
      : '';

    const roleBadge = role
      ? `
        <span class="badge badge-type badge-${escapeHtml(role)}">
          ${escapeHtml(roleLabels[role] || role)}
        </span>
      `
      : '';

    const revisedMeta = revised
      ? `<div class="search-result-meta">Revised: ${escapeHtml(formatDate(revised))}</div>`
      : '';

    return `
      <div class="search-result-item">
        <div class="search-result-title">
          <a href="${result.url}">${escapeHtml(title)}</a>
        </div>

        <div class="search-result-badges">
          ${typeBadge}
          ${domainBadge}
          ${roleBadge}
        </div>

        ${excerpt ? `<p class="search-result-snippet">${excerpt}</p>` : ''}

        ${revisedMeta}

        <div class="search-result-meta">
          ${escapeHtml(result.url)}
        </div>
      </div>
    `;
  }

  function formatDate(value) {
    if (!value) return '';

    return new Date(value).toLocaleDateString('en-AU', {
      day: 'numeric',
      month: 'long',
      year: 'numeric',
    });
  }

  function slugify(value) {
    return String(value).toLowerCase().replace(/\s+/g, '-');
  }

  function escapeHtml(str) {
    const div = document.createElement('div');
    div.textContent = str;
    return div.innerHTML;
  }
</script>