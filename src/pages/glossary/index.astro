---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import StatusBadge from '@/components/StatusBadge.astro';
import TypeBadge from '@/components/TypeBadge.astro';

function formatDate(value?: string) {
  if (!value) return '';

  return new Date(value).toLocaleDateString('en-AU', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });
}

const domainLabels: Record<string, string> = {
  'conceptual-foundations': 'Foundations',
  'philosophy-of-biology': 'Philosophy',
  'evolutionary-dynamics': 'Evolution',
  'developmental-organisation': 'Development',
  'ecological-organisation': 'Ecology',
  'cognition-and-mind': 'Cognition',
  'social-organisation': 'Sociality',
  'diagnostics-and-empirical-tractability': 'Evidence',
  'methodology-and-explanation': 'Explanation',
  'artificial-systems-and-boundaries': 'Boundaries',
};

const glossary = await getCollection('glossary');
glossary.sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<BaseLayout
  title="Glossary"
  description="The conceptual spine of the APS framework — precise definitions of key terms."
>
  <div class="content-wrapper">
    <Breadcrumb items={[{ label: 'Glossary' }]} />

    <header class="page-header">
      <h1>Glossary</h1>
      <p>
        The conceptual spine of the APS framework. Each entry provides a precise definition, brief
        summary, and links to related concepts.
      </p>
    </header>

    <section
      id="glossary-relationship-example"
      class="article-text-block"
      aria-labelledby="glossary-relationship-heading"
    >
      <h2 id="glossary-relationship-heading">
        An Example of Conceptual Relationships
      </h2>

      <p>
        APS distinguishes biological agency from cognition.
        <a href="/glossary/biological-agency/">Biological agency</a>
        concerns viability-oriented organisational activity, while
        <a href="/glossary/cognition/">cognition</a>
        involves the additional organisation of biological significance
        across time. On this account, living activity does not automatically
        qualify as cognitive.
      </p>

      <p>
        Readers can examine these definitions, follow the reasoning behind
        the distinction, and consider its limitations. This illustrates how
        the glossary connects concepts while preserving important differences
        between them. It presents an APS philosophical proposal, not proof
        that its account of cognition is uniquely correct or scientifically
        superior.
      </p>
    </section>

    <ul class="card-list">
      {
        glossary.map((entry) => (
          <li class="card">
            <div class="card-header">
              <h3 class="card-title">
                <a href={`/glossary/${entry.data.slug}/`}>{entry.data.title}</a>
              </h3>
              <span class={`badge badge-domain badge-domain-${entry.data.cluster}`}>
                {domainLabels[entry.data.cluster] ?? entry.data.cluster}
              </span>

              <TypeBadge type="glossary" />
            </div>

            <p class="card-excerpt">{entry.data.inBrief}</p>

            {entry.data.revised && (
              <div class="card-meta">Revised: {formatDate(entry.data.revised)}</div>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
