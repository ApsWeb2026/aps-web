---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import StatusBadge from '@/components/StatusBadge.astro';
import TypeBadge from '@/components/TypeBadge.astro';

function formatDate(value?: string) {
  if (!value) return '';

  return new Date(value).toLocaleDateString('en-AU', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });
}

const domainLabels: Record<string, string> = {
  'conceptual-foundations': 'Foundations',
  'philosophy-of-biology': 'Philosophy',
  'evolutionary-dynamics': 'Evolution',
  'developmental-organisation': 'Development',
  'ecological-organisation': 'Ecology',
  'cognition-and-mind': 'Cognition',
  'social-organisation': 'Sociality',
  'diagnostics-and-empirical-tractability': 'Evidence',
  'methodology-and-explanation': 'Explanation',
  'artificial-systems-and-boundaries': 'Boundaries',
};

const articles = await getCollection('articles');
const statusOrder: Record<string, number> = { canonical: 0, evolving: 1, draft: 2 };

articles.sort(
  (a, b) =>
    (statusOrder[a.data.status] ?? 9) - (statusOrder[b.data.status] ?? 9) ||
    a.data.title.localeCompare(b.data.title),
);
---

<BaseLayout title="Articles" description="Research articles exploring Agency, Process, and Scale.">
  <div class="content-wrapper">
    <Breadcrumb items={[{ label: 'Articles' }]} />

    <header class="page-header">
      <h1>Articles</h1>
      <p>
        Research essays developing APS as an explanatory framework for understanding life as
        viability-oriented organised persistence. Canonical articles present the stabilised
        conceptual architecture of the framework, while evolving and draft articles extend,
        refine, and integrate its major explanatory pathways across biological organisation,
        evolution, cognition, diagnosis, and philosophy of biology.
      </p>
    </header>

    <ul class="card-list">
      {
        articles.map((entry) => (
          <li class="card">
            <div class="card-header">
              <h3 class="card-title">
                <a href={`/articles/${entry.data.slug}/`}>{entry.data.title}</a>
              </h3>
              <span class={`badge badge-domain badge-domain-${entry.data.cluster}`}>
              {domainLabels[entry.data.cluster] ?? entry.data.cluster}
              </span>

              {entry.data.role && <TypeBadge type={entry.data.role} />}
            </div>

            <p class="card-excerpt">{entry.data.abstract}</p>

            {entry.data.revised && (
              <div class="card-meta">Revised: {formatDate(entry.data.revised)}</div>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>